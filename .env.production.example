# Copy to .env.production, chmod 600, and fill every required field.
# Use a real, stable public IPv4, without https:// or a port.
PUBLIC_IPV4=
ACME_EMAIL=
# Build/load a commit-tagged image on the VM, or use an existing registry image.
APP_IMAGE=
# Use a long random password. Single quotes preserve literal dollar signs.
DATABASE_PASSWORD=

# Starting budgets only: confirm RAM and leave room for Linux/Docker.
APP_MEMORY=1g
DB_MEMORY=512m
CADDY_MEMORY=128m

# Use the staging URL from the runbook for an isolated issuance rehearsal.
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
