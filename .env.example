# Choose a private password before starting PostgreSQL.
DATABASE_PASSWORD=change-this-local-password

# Local packaged app defaults. For public HTTPS, set all three values below:
# TABLE_DOMAIN=table.example.com
# PUBLIC_ORIGIN=https://table.example.com
# SECURE_COOKIE=true
PUBLIC_ORIGIN=http://127.0.0.1:8080
SECURE_COOKIE=false
TABLE_DOMAIN=localhost
